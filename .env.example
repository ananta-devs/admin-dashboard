# ==============================================================================
# ENTERPRISE ADMIN PLATFORM - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Settings (PostgreSQL 16)
POSTGRES_DB=vibe_enterprise
POSTGRES_USER=vibe_admin
POSTGRES_PASSWORD=dev_secret_postgres_pass_change_in_prod
DATABASE_URL=postgresql+asyncpg://vibe_admin:dev_secret_postgres_pass_change_in_prod@127.0.0.1:5432/vibe_enterprise
DATABASE_SYNC_URL=postgresql+psycopg://vibe_admin:dev_secret_postgres_pass_change_in_prod@127.0.0.1:5432/vibe_enterprise

# Redis Broker & Cache Settings (Redis 7)
REDIS_PASSWORD=dev_secret_redis_pass_change_in_prod
REDIS_URL=redis://:dev_secret_redis_pass_change_in_prod@127.0.0.1:6379/0
REDIS_CACHE_URL=redis://:dev_secret_redis_pass_change_in_prod@127.0.0.1:6379/1

# Security & Master Encryption Keys (64-character hex strings)
SESSION_SECRET_KEY=replace_with_secure_64_character_hex_session_secret_key
ENCRYPTION_MASTER_KEY=replace_with_secure_64_character_hex_master_encryption_key
RATE_LIMIT_HMAC_KEY=replace_with_secure_64_character_hex_rate_limit_hmac_key

# Service URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Storage
FILE_STORAGE_PATH=./uploads

# ==============================================================================
# Phase 4: Authentication, Session Management & Account Security
# ==============================================================================
ENVIRONMENT=development
COOKIE_NAME=vibe_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_LIFETIME_SECONDS=43200
SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=60

# Argon2id Password Hashing Operational Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_SALT_LEN=16
ARGON2_HASH_LEN=32

# Multi-Factor Authentication (TOTP AES-256-GCM)
MFA_ENCRYPTION_KEY=replace_with_secure_64_character_hex_mfa_encryption_key
MFA_KEY_VERSION=1
MFA_CHALLENGE_TIMEOUT_SECONDS=300

# Email Delivery Configuration (memory for local dev/testing, smtp for production)
EMAIL_BACKEND=memory
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@vibe.enterprise
EMAILS_FROM_NAME="VIBE Platform"

# Action Tokens Lifetime & Policies
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_SECONDS=86400
PASSWORD_RESET_TOKEN_EXPIRE_SECONDS=1800

# Redis Rate Limiting Parameters (per-minute limits)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=5
RATE_LIMIT_VERIFY_EMAIL_PER_MINUTE=10
RATE_LIMIT_MFA_PER_MINUTE=10
RATE_LIMIT_FAIL_CLOSED=true

# ==============================================================================
# Phase 7: Analytics Engine, Python Data Processing & Celery Background Jobs
# ==============================================================================
CELERY_BROKER_URL=redis://:dev_secret_redis_pass_change_in_prod@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:dev_secret_redis_pass_change_in_prod@127.0.0.1:6379/2
ANALYTICS_STORAGE_PATH=./uploads/analytics
ANALYTICS_MAX_SOURCE_ROWS=500000
ANALYTICS_MAX_SOURCE_COLS=500
ANALYTICS_MAX_CONCURRENT_JOBS_PER_ORG=5
ANALYTICS_MAX_CONCURRENT_JOBS_PER_USER=2
ANALYTICS_JOB_TIMEOUT_SECONDS=300
ANALYTICS_WORKER_LEASE_SECONDS=60



